{
  "name": "@dropship/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@dropship/config": "workspace:*",
    "@dropship/core": "workspace:*",
    "@dropship/db": "workspace:*",
    "@dropship/logger": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "pg-boss": "^10.1.6",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "vitest": "^3.0.0"
  }
}
