{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.json", "eslint.config.mjs"],
  "globalEnv": ["APP_ENV", "NODE_ENV"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DIRECT_DATABASE_URL",
    "LOG_LEVEL",
    "NEXT_PUBLIC_*",
    "SUPABASE_*",
    "ANTHROPIC_*",
    "STRIPE_*",
    "ALIEXPRESS_*",
    "RESEND_*",
    "EMAIL_FROM",
    "SENTRY_*",
    "CREDENTIALS_ENCRYPTION_KEY",
    "HEALTH_PORT",
    "WORKER_*",
    "FEATURE_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "outputs": []
    }
  }
}
