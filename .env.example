# Copy to `.env` (repo root, read by the worker and db scripts) and `apps/web/.env.local` (Next.js).
# Never commit real values.

# ---------- Core ----------
# development | test | staging | production   (NOT NODE_ENV — `next build` always sets NODE_ENV=production)
APP_ENV=development
LOG_LEVEL=info

# ---------- Database ----------
# Local: `pnpm db:up` starts Postgres on port 54329.
# Supabase: DATABASE_URL = transaction pooler (port 6543); DIRECT_DATABASE_URL = session/direct (port 5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/dropship
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/dropship
DATABASE_POOL_MAX=10

# ---------- Worker ----------
HEALTH_PORT=8080
WORKER_SHUTDOWN_TIMEOUT_MS=30000
WORKER_PGBOSS_SCHEMA=pgboss
WORKER_HEARTBEAT_STALE_SECONDS=300
WORKER_STUCK_JOB_MINUTES=30

# ---------- Feature flags ----------
FEATURE_AUTO_PUBLISH=false
FEATURE_DRY_RUN_FULFILLMENT=true

# ---------- Integrations (optional in development, ALL required when APP_ENV=production) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Enrichment stops (products go to enrichment_failed) once this much was spent today (UTC).
ANTHROPIC_DAILY_BUDGET_USD=25
# realtime | batch (Batches API, 50% cheaper, results within 24h) | off
AI_ENRICH_MODE=realtime
AI_BATCH_MAX_ITEMS=200
# Test keys (sk_test_) everywhere except production; production requires a live key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# Callback registered in the AliExpress app console; the page shows the one-time code.
ALIEXPRESS_REDIRECT_URI=http://localhost:3000/integrations/aliexpress/callback
ALIEXPRESS_REQUESTS_PER_SECOND=5

# ---------- Pricing (see packages/core/src/pricing.ts) ----------
# ILS per USD. Required in production; pricing is skipped while unset.
PRICING_USD_ILS_RATE=
PRICING_FX_BUFFER=0.03
PRICING_VAT_RATE=0.18
PRICING_PAYMENT_FEE_RATE=0.029
PRICING_PAYMENT_FEE_FIXED_MINOR=120

# ---------- Catalog import ----------
IMPORT_SHIP_TO=IL
# SKUs without TRACKED shipping within this many days are imported inactive.
IMPORT_MAX_SHIPPING_DAYS=30

# ---------- Media storage ----------
# local (development) | r2 (required in production)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
LOCAL_STORAGE_PUBLIC_URL=http://localhost:3000/media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
RESEND_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# ---------- Browser (apps/web only) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------- Tests ----------
# Enables the database integration suites. Must be a DISPOSABLE database — tests archive and
# rewrite rows. `pnpm db:test:reset` (re)creates it; `pnpm test:all` resets it and runs everything.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/dropship_test
