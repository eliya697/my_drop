# Copy to `.env` (repo root, read by the worker and db scripts) and `apps/web/.env.local` (Next.js).
# Never commit real values.

# ---------- Core ----------
# development | test | staging | production   (NOT NODE_ENV — `next build` always sets NODE_ENV=production)
APP_ENV=development
LOG_LEVEL=info

# ---------- Database ----------
# Local: `pnpm db:up` starts Postgres on port 54329.
# Supabase: DATABASE_URL = transaction pooler (port 6543); DIRECT_DATABASE_URL = session/direct (port 5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/dropship
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/dropship
DATABASE_POOL_MAX=10

# ---------- Worker ----------
HEALTH_PORT=8080
WORKER_SHUTDOWN_TIMEOUT_MS=30000
WORKER_PGBOSS_SCHEMA=pgboss
WORKER_HEARTBEAT_STALE_SECONDS=300
WORKER_STUCK_JOB_MINUTES=30

# ---------- Feature flags ----------
FEATURE_AUTO_PUBLISH=false
FEATURE_DRY_RUN_FULFILLMENT=true

# ---------- Integrations (optional in development, ALL required when APP_ENV=production) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_DAILY_BUDGET_USD=25
# Test keys (sk_test_) everywhere except production; production requires a live key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# ---------- Browser (apps/web only) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------- Tests ----------
# Enables the database integration suite (`pnpm test`). Use a disposable database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/dropship
