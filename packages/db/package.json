{
  "name": "@dropship/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "check": "drizzle-kit check",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@dropship/config": "workspace:*",
    "@dropship/core": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.2",
    "vitest": "^3.0.0"
  }
}
